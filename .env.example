# OpenAI (default if LLM_BASE_URL is unset)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Self-hosted Llama via SSH port-forward (vLLM / TGI / Ollama / llama.cpp)
# 1) On your laptop:  ssh -N -L 8000:localhost:8000 user@gpu-host
# 2) Uncomment below. LLM_API_KEY can be left unset — defaults to "EMPTY".
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# LLM_API_KEY=                  # leave blank for self-hosted
